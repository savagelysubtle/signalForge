# SignalForge Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — your keys stay local.

# ── LLM API Keys ──────────────────────────────────────────
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
CHARTIMG_API_KEY=

# ── Data API Keys ────────────────────────────────────────
# Financial Modeling Prep: screener, quotes, and company profile (GICS sector).
# Required for MCP sector-concentration enforcement via POST /api/execution/sector-concentration.
# Without it, that gate passes with "skipped" and does not block trades.
FMP_API_KEY=

# ── Cloud Infrastructure ──────────────────────────────────
# Set ENVIRONMENT=production for cloud deploys, development for local
ENVIRONMENT=development

# Database (leave blank for local SQLite fallback)
DATABASE_URL=

# Supabase (auth + chart image storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# ── MCP server (optional — same file if MCP loads repo-root .env) ──
# JWT for the signed-in Supabase user (Bearer token the FastAPI backend expects).
# Needed for: POST /api/outcomes/brokerage-open, execution/sector-concentration,
# GET /api/outcomes/daily-summary. From browser: DevTools → Application →
# Local Storage → supabase.auth.token → access_token (or session from Supabase dashboard).
# SIGNALFORGE_BACKEND_URL=http://localhost:8420
# SIGNALFORGE_AUTH_TOKEN=
