# SignalForge MCP Server Configuration
# Copy to .env next to this file, or use the repo-root .env (also loaded automatically).

# Backend connection — must match the FastAPI process you use (default local port 8420).
SIGNALFORGE_BACKEND_URL=http://localhost:8420

# Supabase JWT for the same user as the web app (Authorization: Bearer …).
# Required for: logging opens after IBKR fills (brokerage-open), sector concentration
# API, and daily outcome summary. Get access_token after login (browser localStorage
# key supabase.auth.token, or Supabase Auth session). Leave empty only if you do not
# use those features.
SIGNALFORGE_AUTH_TOKEN=

# Interactive Brokers connection
IBKR_HOST=127.0.0.1
IBKR_PORT=7497                        # 7497=TWS paper, 7496=TWS live, 4002=GW paper, 4001=GW live
IBKR_CLIENT_ID=1
IBKR_PAPER=true

# Risk limits
DAILY_LOSS_LIMIT_PCT=2.0              # Max daily loss as % of equity
MAX_POSITION_SIZE_PCT=5.0             # Hard cap on position size %
MAX_PORTFOLIO_EXPOSURE_PCT=25.0       # Max total portfolio exposure %
MIN_CONFIDENCE=0.60                   # Minimum recommendation confidence
MAX_ORDERS_PER_HOUR=10                # Rate limit on order placement
REQUIRE_MARKET_HOURS=true             # Only trade during US market hours

# Backend must have FMP_API_KEY set for sector limits to enforce (otherwise check is skipped).

# Auto-execute (opt-in): place_order(..., auto=true) without confirmed=true
AUTO_EXECUTE_ENABLED=false
AUTO_EXECUTE_MIN_CONFIDENCE=0.75

# Sector concentration (IBKR STK positions + FMP profile)
SECTOR_CONCENTRATION_ENABLED=true
MAX_POSITIONS_PER_SECTOR=2
