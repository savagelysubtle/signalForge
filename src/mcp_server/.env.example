# SignalForge MCP Server Configuration

# Backend connection
SIGNALFORGE_BACKEND_URL=http://localhost:8420
SIGNALFORGE_AUTH_TOKEN=               # Supabase JWT (empty for dev mode)

# Interactive Brokers connection
IBKR_HOST=127.0.0.1
IBKR_PORT=7497                        # 7497=TWS paper, 7496=TWS live, 4002=GW paper, 4001=GW live
IBKR_CLIENT_ID=1
IBKR_PAPER=true

# Risk limits
DAILY_LOSS_LIMIT_PCT=2.0              # Max daily loss as % of equity
MAX_POSITION_SIZE_PCT=5.0             # Hard cap on position size %
MAX_PORTFOLIO_EXPOSURE_PCT=25.0       # Max total portfolio exposure %
MIN_CONFIDENCE=0.60                   # Minimum recommendation confidence
MAX_ORDERS_PER_HOUR=10                # Rate limit on order placement
REQUIRE_MARKET_HOURS=true             # Only trade during US market hours
