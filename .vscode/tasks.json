{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Frontend",
      "type": "shell",
      "command": "cd '${workspaceFolder}/src/frontend' && bun run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "presentation": {
        "group": "signalforge",
        "panel": "shared"
      }
    },
    {
      "label": "Kill Port 8420",
      "type": "shell",
      "command": "Get-NetTCPConnection -LocalPort 8420 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }; Start-Sleep -Milliseconds 500",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "group": "signalforge"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Backend",
      "type": "shell",
      "dependsOn": ["Kill Port 8420"],
      "command": "cd '${workspaceFolder}/src/backend' && uv run --python 3.14 uvicorn main:app --reload --reload-dir . --port 8420",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Application startup complete"
        }
      },
      "presentation": {
        "group": "signalforge",
        "panel": "shared"
      }
    },
    {
      "label": "Start SignalForge (All)",
      "dependsOn": ["Start Backend", "Start Frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}