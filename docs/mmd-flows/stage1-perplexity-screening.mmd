%% SignalForge — Stage 1: Perplexity Screening
%% Shows how FMP quantitative data and strategy prompts feed into
%% Perplexity's Agent API, which uses web search and optional FMP
%% tool calls to produce a validated ScreeningResult.

flowchart TD
    subgraph INPUTS["Inputs to Perplexity"]
        FMP_DATA["FMP Scored Candidates\n(composite scores, insider data,\nanalyst consensus, momentum,\nPiotroski, RVOL, earnings)"]
        STRAT_PROMPT["Strategy Screening Prompt\n(defines what to look for)"]
        MODE["Mode:\ndiscovery | analysis |\nprompt | combined"]
    end

    FMP_DATA --> FORMAT["_format_fmp_context()\n\nFormats all enriched data\ninto readable text block:\n- Score X/100\n- RVOL, Insider NET BUY\n- Analyst consensus + upside\n- Price chg 1D/1M/3M\n- Piotroski, Earnings date"]

    FORMAT --> PROMPT_BUILD["build_discovery_prompt()\n\nCombines:\n1. Strategy screening prompt\n2. FMP context block\n3. Output format instructions\n4. JSON schema requirements"]

    STRAT_PROMPT --> PROMPT_BUILD

    PROMPT_BUILD --> AGENT_API

    subgraph AGENT_API["Perplexity Agent API (sonar)"]
        SEARCH["Web Search Tool\n(automatic — searches\nfinance sites, news,\nSEC filings, analyst reports)"]
        FMP_TOOL["FMP Screener Tool\n(function call — can\nre-screen with different\nparams at runtime)"]
        REASON["LLM Reasoning\n(evaluates FMP quant data\n+ web qualitative data\n-> selects best candidates)"]
    end

    AGENT_API --> VALIDATE["Pydantic Validation\n(ScreeningResult schema)\n\nMax 2 retries with\nerror context injection"]

    VALIDATE -->|"Validation fails"| RETRY["Retry with error:\n'Fix these fields: ...'"]
    RETRY --> AGENT_API
    VALIDATE -->|"Valid"| RESULT

    subgraph RESULT["ScreeningResult Output"]
        TICKERS["tickers: FundamentalData[]\n- ticker, company_name\n- sector, market_cap, P/E\n- key_highlights[]\n- risk_factors[]\n- news_urls[] (from citations)"]
        SUMMARY["screening_summary:\nWhy these stocks were chosen"]
        CITATIONS["citations[]: source URLs\n(distributed to per-ticker\nnews_urls by _distribute_citations)"]
    end

    RESULT -->|"Per-ticker news_urls\nfor grounded sentiment"| GEMINI["To Stage 2: Gemini"]
    RESULT -->|"Full ScreeningResult\nfor final synthesis"| GPT["To Stage 4: GPT"]
    RESULT -->|"Ticker list\nfor chart generation"| CLAUDE["To Stage 3: Claude"]
