%% SignalForge — Stage 4.5: Annotated Charts
%% Shows how GPT's trade parameters (entry, stop, target) and
%% Claude's key levels are overlaid onto chart images using
%% Chart-Img v2's drawings API to produce annotated visuals.

flowchart TD
    subgraph INPUTS["Inputs"]
        CHARTS["ChartAnalysis[]\nfrom Claude\n(key_levels: support/resistance\nwith price and strength)"]
        RECS["Recommendations[]\nfrom GPT Judge\n(entry_price, stop_loss,\ntake_profit per ticker)"]
    end

    CHARTS --> MERGE["Match ChartAnalysis to\nRecommendation by ticker\n(rec_map)"]
    RECS --> MERGE

    MERGE --> PARALLEL["asyncio.gather()\nAnnotate all charts concurrently"]

    subgraph ANNOTATE["Per Chart Annotation"]
        FETCH["fetch_annotated_chart()\n\nChart-Img v2 POST /chart\nwith drawings[] overlay:\n- Horizontal lines at\n  support/resistance levels\n- Entry price line (green)\n- Stop loss line (red)\n- Take profit line (blue)"]
        UPLOAD["Upload annotated PNG to\nSupabase Storage\n(charts/annotated/ bucket)"]
        UPDATE["Update ChartAnalysis\nannotated_chart_path\nwith Supabase CDN URL"]
    end

    PARALLEL --> FETCH --> UPLOAD --> UPDATE

    UPDATE --> PERSIST["Update stage_outputs row\nin PostgreSQL with new\nannotated_chart_path\n(survives database reload)"]

    PERSIST --> FRONTEND["Frontend loads annotated\nchart images directly\nfrom Supabase CDN"]

    subgraph DEGRADED["Failure Handling"]
        FAIL["If annotation fails for\na specific ticker:\n- Log warning\n- Original chart remains\n- annotated_chart_path\n  stays empty\n- Pipeline continues"]
    end
