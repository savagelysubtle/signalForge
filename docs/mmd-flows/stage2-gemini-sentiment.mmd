%% SignalForge — Stage 2: Gemini Sentiment Analysis
%% Shows how Perplexity-provided news URLs are used by Gemini with
%% Google Search grounding to produce per-ticker sentiment scores
%% and catalysts. Runs BEFORE Claude so chart analysis has news context.

flowchart TD
    subgraph INPUTS["Inputs from Perplexity"]
        TICKERS["Ticker list:\ne.g. AAPL, NVDA, SHOP"]
        NEWS_URLS["Per-ticker news_urls:\nAAPL: url1, url2\nNVDA: url3, url4"]
        CONFIG["Strategy Config:\nnews_recency, news_scope"]
    end

    TICKERS --> PARALLEL["asyncio.gather()\nOne Gemini call per ticker\n(concurrent, semaphore=5)"]
    NEWS_URLS --> PARALLEL

    subgraph PER_TICKER["Per-Ticker Gemini Call"]
        PROMPT["build_sentiment_prompt()\n\nIncludes:\n- Ticker symbol\n- Perplexity-provided news URLs\n- News recency window\n- News scope (company/sector/macro)\n- JSON output format"]
        CALL["Gemini 2.5 Pro API\n+ Google Search Grounding\n\nGemini reads the provided URLs\nAND searches for additional\nrecent news via Google Search"]
        VALIDATE["Pydantic Validation\n(SentimentAnalysis schema)\nMax 2 retries"]
    end

    PARALLEL --> PROMPT --> CALL --> VALIDATE

    VALIDATE -->|"Valid"| OUTPUT

    subgraph OUTPUT["SentimentAnalysis Output (per ticker)"]
        SCORE["sentiment_score: -1.0 to +1.0"]
        LABEL["sentiment_label:\nstrongly_bearish | bearish |\nneutral | bullish | strongly_bullish"]
        CATALYSTS["key_catalysts: NewsCatalyst[]\n- headline, source, url\n- impact: pos/neg/neutral\n- significance: high/med/low"]
        SECTOR["sector_sentiment: text"]
        SUM["summary: paragraph"]
    end

    OUTPUT -->|"News context injected\ninto Claude's chart prompt"| CLAUDE["To Stage 3: Claude"]
    OUTPUT -->|"Sentiment data flows\nto GPT for synthesis"| GPT["To Stage 4: GPT"]

    subgraph DEGRADED["Degraded Mode"]
        FAIL["If Gemini fails entirely:\n- Claude proceeds WITHOUT\n  news context section\n- GPT judge is told\n  'sentiment data unavailable'\n- Pipeline continues"]
    end
