%% SignalForge — Data Handoff Sequence
%% Shows the sequential and parallel execution flow with exact
%% Pydantic schema types passed between each stage.
%% Updated: Regime Classifier (0.5), Risk Validator (4.7), FinMem memory

sequenceDiagram
    participant User
    participant Orchestrator
    participant FMP as Stage 0: FMP
    participant Regime as Stage 0.5: Regime
    participant Perplexity as Stage 1: Perplexity
    participant Gemini as Stage 2: Gemini
    participant Claude as Stage 3: Claude
    participant GPT_Bull as Stage 4: GPT Bull
    participant GPT_Bear as Stage 4: GPT Bear
    participant GPT_Judge as Stage 4: GPT Judge
    participant RiskVal as Stage 4.7: Risk Validator
    participant ChartImg as Stage 4.5: Annotate
    participant Reflection as FinMem Reflection
    participant DB as PostgreSQL

    User->>Orchestrator: run_pipeline(strategy_id, tickers?, prompt?)
    Orchestrator->>DB: INSERT pipeline_runs (status=running)

    Note over Orchestrator,FMP: Stage 0 — Quantitative Pre-Screening

    Orchestrator->>FMP: screen_and_enrich(FmpScreenerConfig)
    activate FMP
    FMP->>FMP: /stable/company-screener
    FMP->>FMP: Bulk fetch (5 parallel calls)
    FMP->>FMP: Per-ticker extended enrichment
    FMP->>FMP: Post-filters + Composite scoring
    FMP->>FMP: Sector cap + Earnings filter
    FMP-->>Orchestrator: FmpEnrichedStock[] (scored, ranked)
    deactivate FMP

    Note over Orchestrator,Regime: Stage 0.5 — Market Regime Classification

    Orchestrator->>Regime: classify_regime(run_id)
    activate Regime
    Regime->>Regime: Perplexity Agent API (web search)
    Regime->>Regime: Search SPX trend, VIX, breadth, sectors
    Regime->>Regime: Validate RegimeOutput (Pydantic)
    Regime-->>Orchestrator: RegimeOutput (regime_type, vix, breadth, sectors)
    deactivate Regime

    Orchestrator->>Orchestrator: format_regime_header(regime) → regime_context string
    Orchestrator->>DB: Save stage_output (regime)

    Note over Orchestrator,Perplexity: Stage 1 — Web Research + Selection

    Orchestrator->>Perplexity: run_discovery(config, fmp_candidates)
    activate Perplexity
    Perplexity->>Perplexity: Format FMP context + strategy prompt
    Perplexity->>Perplexity: Agent API (web search + FMP tool)
    Perplexity->>Perplexity: Validate ScreeningResult (Pydantic)
    Perplexity-->>Orchestrator: ScreeningResult (tickers[], news_urls[], citations[])
    deactivate Perplexity

    Orchestrator->>DB: Save stage_output (perplexity)

    Note over Orchestrator,Gemini: Stage 2 — News Sentiment (concurrent per ticker)

    par For each ticker
        Orchestrator->>Gemini: run_sentiment(ticker, news_urls, config, regime_context)
        activate Gemini
        Gemini->>Gemini: Google Search grounding + provided URLs
        Gemini->>Gemini: Validate SentimentAnalysis (Pydantic)
        Gemini-->>Orchestrator: SentimentAnalysis
        deactivate Gemini
    end

    Orchestrator->>DB: Save stage_outputs (gemini, per ticker)

    Note over Orchestrator,Claude: Stage 3 — Chart Analysis (concurrent per ticker x timeframe)

    par For each ticker
        Orchestrator->>ChartImg: fetch_chart_image(ticker, D)
        ChartImg-->>Claude: PNG (primary timeframe)
        Orchestrator->>ChartImg: fetch_chart_image(ticker, 4H)
        ChartImg-->>Claude: PNG (secondary timeframe)
        Orchestrator->>Claude: run_chart_analysis(image, sentiment, config, regime_context)
        activate Claude
        Claude->>Claude: Vision API reads chart + news + regime context
        Claude->>Claude: Validate ChartAnalysis (Pydantic)
        Claude-->>Orchestrator: ChartAnalysis (trend, levels, patterns, bias, ATR)
        deactivate Claude
    end

    Orchestrator->>DB: Save stage_outputs (claude, per ticker)

    Note over Orchestrator,Reflection: Load FinMem Memory for Judge

    Orchestrator->>Reflection: load_reflection_context(user_id)
    activate Reflection
    Reflection->>DB: Query reflections (latest injection_prompt)
    DB-->>Reflection: injection_prompt (SHORT-TERM + LONG-TERM memory)
    Reflection-->>Orchestrator: reflection_context string
    deactivate Reflection

    Note over Orchestrator,GPT_Judge: Stage 4 — Debate + Synthesis

    par Bull and Bear run simultaneously
        Orchestrator->>GPT_Bull: _call_gpt_bull(screening, sentiment, charts)
        activate GPT_Bull
        GPT_Bull-->>Orchestrator: DebateCaseList (bull arguments per ticker)
        deactivate GPT_Bull

        Orchestrator->>GPT_Bear: _call_gpt_bear(screening, sentiment, charts)
        activate GPT_Bear
        GPT_Bear-->>Orchestrator: DebateCaseList (bear arguments per ticker)
        deactivate GPT_Bear
    end

    Orchestrator->>DB: Save stage_outputs (gpt_bull, gpt_bear)

    Orchestrator->>GPT_Judge: build_judge_prompt(ALL data + debate + reflection + regime_context)
    activate GPT_Judge
    GPT_Judge->>GPT_Judge: Weigh bull vs bear arguments
    GPT_Judge->>GPT_Judge: Cross-reference technicals + sentiment
    GPT_Judge->>GPT_Judge: Read weighted bias score per ticker
    GPT_Judge->>GPT_Judge: Apply FinMem short/long term memory
    GPT_Judge->>GPT_Judge: Apply risk params + position sizing
    GPT_Judge->>GPT_Judge: Validate RecommendationList (Pydantic)
    GPT_Judge-->>Orchestrator: Recommendation[] (BUY/SELL/HOLD + trade params)
    deactivate GPT_Judge

    Orchestrator->>DB: Save recommendations + stage_output (gpt_judge)

    Note over Orchestrator,RiskVal: Stage 4.7 — Deterministic Risk Validation

    Orchestrator->>RiskVal: validate_risks(recommendations, config, charts, fmp)
    activate RiskVal
    RiskVal->>RiskVal: Check R:R ratio vs min_risk_reward
    RiskVal->>RiskVal: Check position size vs max_position_pct
    RiskVal->>RiskVal: Check ATR-based stop distance (0.8x–2.5x)
    RiskVal->>RiskVal: Check earnings proximity (<= 5 days)
    RiskVal->>RiskVal: Check low conviction (confidence < 0.45)
    RiskVal-->>Orchestrator: Recommendation[] (+ risk_violations[], risk_approved)
    deactivate RiskVal

    Note over Orchestrator,ChartImg: Stage 4.5 — Annotated Charts (concurrent)

    par For each ChartAnalysis
        Orchestrator->>ChartImg: fetch_annotated_chart(levels, entry, stop, target)
        ChartImg-->>Orchestrator: Annotated PNG URL
    end

    Orchestrator->>DB: Update stage_outputs with annotated_chart_path
    Orchestrator->>DB: UPDATE pipeline_runs (status=completed)
    Orchestrator-->>User: PipelineResult (all data + recommendations + risk flags)

    Note over User,DB: Feedback Loop (User-Driven)

    User->>DB: POST /decisions (follow/pass + reason)
    User->>DB: POST /outcomes (entry, exit, PnL, hold_days, notes)
    Note over Reflection,DB: Reflection Generation (on demand)
    Reflection->>DB: Query decisions + outcomes + recommendations
    Reflection->>DB: Join stage_outputs (patterns, sector, biases)
    Reflection->>Reflection: _compute_metrics() — pattern accuracy,<br/>sector win rates, TF alignment, streaks
    Reflection->>Reflection: build_memory_injection() —<br/>SHORT-TERM (14d) + LONG-TERM (all-time)
    Reflection->>Reflection: _get_strategic_advice() — GPT-4o-mini
    Reflection->>DB: INSERT reflections (injection_prompt)
